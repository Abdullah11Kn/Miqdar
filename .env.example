# =============================================================================
# Smart Nutrition Scale - Environment Configuration
# =============================================================================

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="YOUR_API_KEY_HERE"

# Primary Gemini Vision Model (Default: gemini-3.1-flash-lite-preview for ultra-fast response)
GEMINI_MODEL="gemini-3.1-flash-lite-preview"

# Fallback Models (comma-separated list tried automatically if primary returns 404/503/429)
GEMINI_FALLBACK_MODELS="gemini-3-flash-preview,gemini-2.5-flash-image,gemini-flash-latest"

# Timeout per individual Gemini HTTP request in seconds
GEMINI_TIMEOUT_S="20.0"

# Total deadline for an analyze() call including retries and fallbacks
GEMINI_TOTAL_DEADLINE_S="35.0"

# Maximum attempts per model before falling back
GEMINI_ATTEMPTS_PER_MODEL="2"

# Server Host & Port (Default: 0.0.0.0:8085)
HOST="0.0.0.0"
PORT="8085"

# In-memory LRU Cache settings for repeat identical images
CACHE_SIZE="256"
CACHE_TTL_S="86400"
