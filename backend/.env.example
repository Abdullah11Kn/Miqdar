# Keep real keys out of source control.
SFDA_API_KEY=
USDA_FDC_API_KEY=

# Direct Gemini image recognition. The stable project baseline is Gemini 3.1 Flash-Lite.
MIQDAR_RECOGNITION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Optional bearer token for every route except GET /health.
MIQDAR_API_TOKEN=

# Optional provider-neutral alternative. Set MIQDAR_RECOGNITION_PROVIDER=remote.
MIQDAR_CLOUD_ENDPOINT=
MIQDAR_CLOUD_API_KEY=
